<Window x:Class="ZC_ALM_TOOLS.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vmGenerator="clr-namespace:ZC_ALM_TOOLS.ViewModels.Generator"
        xmlns:vmVci="clr-namespace:ZC_ALM_TOOLS.ViewModels.Vci"
        xmlns:vGenerator="clr-namespace:ZC_ALM_TOOLS.Views.Generator"
        xmlns:vVci="clr-namespace:ZC_ALM_TOOLS.Views.Vci"
        Title="ZC ALM Tools" Height="850" Width="1600"
        WindowStartupLocation="CenterScreen" Background="#F5F6F8">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate DataType="{x:Type vmGenerator:GeneratorMainViewModel}">
            <vGenerator:GeneratorMainView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmVci:VciMainViewModel}">
            <vVci:VciMainView />
        </DataTemplate>

        <Style x:Key="SettingsButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Width" Value="35"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="Background" Value="#E5E5E5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1f296e"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2a3680"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="45"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Margin="5,0">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2a3680"/>
                    <Setter Property="BorderBrush" Value="#4554b5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#19215d">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#2a3680" BorderThickness="0,0,0,1">
                    <TextBlock Text="ZC ALM Tools" 
                               Foreground="White" 
                               FontWeight="Bold" 
                               FontSize="17" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Row="1" Margin="0,15,0,0">
                    
                    <Button Command="{Binding ShowGeneratorCommand}" ToolTip="Generador de Procesos" Style="{StaticResource MenuButtonStyle}" Margin="0,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="Procesos" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowVciCommand}" ToolTip="Auditoría VCI" Style="{StaticResource MenuButtonStyle}" Margin="0,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="VCI" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#DDD" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="Objetivo PLC:" Foreground="#666" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>

                        <ComboBox ItemsSource="{Binding PlcTargets}" 
                                  SelectedItem="{Binding SelectedTarget}" 
                                  Width="220" Height="30" FontSize="14" 
                                  Background="#F8F9FA" BorderBrush="#CCC" Padding="0,5,3,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💻 " Margin="5,0,5,0"/>
                                        <TextBlock Text="{Binding Name}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Command="{Binding DumpCacheCommand}"
                                Style="{StaticResource SettingsButtonStyle}"
                                ToolTip="Exportar Caché del PLC a un archivo TXT"
                                Content="🖨️" Margin="10,0,10,0"/>

                        <Button Command="{Binding ConfigSettingsCommand}"
                                Style="{StaticResource SettingsButtonStyle}"
                                ToolTip="Editar configuracion"
                                Content="⚙️"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Margin="10"/>

            <StatusBar Grid.Row="2" Background="#E9ECEF" BorderBrush="#CED4DA" BorderThickness="0,1,0,0">
                <StatusBarItem>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="{Binding StatusColor}" Margin="5,0,10,0"/>
                        <TextBlock Text="{Binding StatusMessage}" FontWeight="Medium" Foreground="#333"/>
                    </StackPanel>
                </StatusBarItem>

                <StatusBarItem HorizontalAlignment="Right" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Trabajando..." FontSize="11" Foreground="#666" Margin="0,0,10,0" VerticalAlignment="Center"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                        <ProgressBar Width="150" Height="14" IsIndeterminate="True" Foreground="#007ACC" BorderThickness="0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Grid>
</Window>