<UserControl x:Class="ZC_ALM_TOOLS.Views.ProcessGeneratorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:ZC_ALM_TOOLS.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:ProcessGeneratorViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>

        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="MainBorder" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="4"/>

                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter IsHitTestVisible="False" 
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                <Path x:Name="Arrow" Grid.Column="1" 
                                      Data="M0,0 L4,4 L8,0" 
                                      Stroke="#666" StrokeThickness="2" 
                                      VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </Grid>

                            <ToggleButton IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup" AllowsTransparency="True" 
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" 
                                   Placement="Bottom" PopupAnimation="Slide">
                                <Border Background="White" BorderBrush="#D0D0D0" BorderThickness="1" 
                                        CornerRadius="4" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="300">
                                    <ScrollViewer>
                                        <ItemsPresenter SnapsToDevicePixels="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#007ACC"/>
                                <Setter TargetName="MainBorder" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#007ACC"/>
                                <Setter TargetName="MainBorder" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" Padding="15">
            <StackPanel>
                <TextBlock Text="CONFIGURACIÓN" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,5"/>
                <TextBlock Text="Proceso a Generar:" Margin="0,0,0,2" Foreground="#555"/>
                <ComboBox ItemsSource="{Binding Processes}"
                          SelectedItem="{Binding SelectedProcess}"
                          Style="{StaticResource ModernComboBoxStyle}"
                          Height="30" Margin="0,0,0,20">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Nombre}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="Plantilla Base:" Margin="0,0,0,2" Foreground="#555"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" 
                              ItemsSource="{Binding Templates}"
                              SelectedItem="{Binding SelectedTemplate}"
                              Style="{StaticResource ModernComboBoxStyle}"
                              Height="30"/>

                    <Button Grid.Column="1" 
                            Command="{Binding RefreshTemplatesCommand}"
                            Width="30" Height="30" Margin="5,0,0,0"
                            Background="#F0F0F0" BorderBrush="#D0D0D0" BorderThickness="1"
                            Cursor="Hand" ToolTip="Escanear carpeta de plantillas">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                        <Path Fill="#555555" Stretch="Uniform" Width="14" Height="14"
                              Data="M17.65,6.35C16.2,4.9 14.21,4 12,4C7.58,4 4.01,7.58 4.01,12C4.01,16.42 7.58,20 12,20C15.73,20 19.2,17.42 19.82,13.82L17.8,13.82C17.2,16.32 14.86,18 12,18C8.69,18 6,15.31 6,12C6,8.69 8.69,6 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"/>
                    </Button>
                </Grid>
                
                <Separator Margin="0,0,0,20" Background="#DDD"/>

                <TextBlock Text="WORKFLOW DE CREACIÓN" FontWeight="Bold" Foreground="#005B96" Margin="0,0,0,10"/>

                <Button Command="{Binding GenerateCommand}" 
                        Content="Generar en TIA Portal"
                        Height="45" Margin="0,10,0,10"
                        Background="#007ACC" BorderThickness="0" Foreground="White" FontWeight="Bold"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <TextBlock Text="*Importará la plantilla desde la ruta configurada, reescribirá referencias y compilará los bloques." 
                           FontSize="10" Foreground="#888" TextWrapping="Wrap" HorizontalAlignment="Center"/>


            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="30">
            <StackPanel>
                <TextBlock Text="Detalles del Proceso a Generar" FontSize="20" FontWeight="Light" Foreground="#333" Margin="0,0,0,20"/>

                <Border Background="{Binding StatusColor}" BorderBrush="#CCC" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,30">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Estado:" FontWeight="Bold" Margin="0,0,10,0" Foreground="#555"/>
                        <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" Foreground="#333"/>
                    </StackPanel>
                </Border>

                <WrapPanel Orientation="Horizontal">
                    <Border Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,20,20" Width="200">
                        <StackPanel>
                            <TextBlock Text="ID / NOMBRE" FontSize="11" Foreground="#888" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#005B96">
                                <Run Text="{Binding SelectedProcess.Id}"/>
                                <Run Text=" - "/>
                                <Run Text="{Binding SelectedProcess.Nombre}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,20,20" Width="200">
                        <StackPanel>
                            <TextBlock Text="Nº DE ETAPAS (TRANSICIONES)" FontSize="11" Foreground="#888" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding SelectedProcess.NumEtapas}" FontSize="18" FontWeight="SemiBold" Foreground="#333"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,20,20" Width="420">
                        <StackPanel>
                            <TextBlock Text="CAPACIDADES (N_MAX)" FontSize="11" Foreground="#888" FontWeight="Bold" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Reales" FontSize="12" Foreground="#666"/>
                                    <TextBlock Text="{Binding SelectedProcess.MaxPReal}" FontSize="16" FontWeight="SemiBold" Foreground="#333"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Enteros" FontSize="12" Foreground="#666"/>
                                    <TextBlock Text="{Binding SelectedProcess.MaxPInt}" FontSize="16" FontWeight="SemiBold" Foreground="#333"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Alarmas" FontSize="12" Foreground="#666"/>
                                    <TextBlock Text="{Binding SelectedProcess.NumAlarmas}" FontSize="16" FontWeight="SemiBold" Foreground="#333"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>