<Window x:Class="ZC_ALM_TOOLS.Views.ToolMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vmGenerator="clr-namespace:ZC_ALM_TOOLS.ViewModels.Generator"
        xmlns:vmVci="clr-namespace:ZC_ALM_TOOLS.ViewModels.Vci"
        xmlns:vGenerator="clr-namespace:ZC_ALM_TOOLS.Views.Generator"
        xmlns:vVci="clr-namespace:ZC_ALM_TOOLS.Views.Vci"
        Title="ZC Engineering Suite" Height="850" Width="1600"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vmGenerator:GeneratorVM}">
            <vGenerator:GeneratorMainView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmVci:VciVM}">
            <vVci:VciMainView />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="#F0F0F0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Border Grid.Column="0" Background="#2C3E50">
            <StackPanel Margin="0,20">
                <Button Command="{Binding ShowGeneratorCommand}" ToolTip="Generador" Background="Transparent" BorderThickness="0" Margin="0,10">
                    <TextBlock Text="⚙️" FontSize="30"/>
                </Button>
                <Button Command="{Binding ShowVciCommand}" ToolTip="Auditoría VCI" Background="Transparent" BorderThickness="0" Margin="0,10">
                    <TextBlock Text="🔍" FontSize="30"/>
                </Button>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="White" BorderBrush="#DDD" BorderThickness="0,0,1,0">
            <StackPanel>
                <Border Background="#EEE" Padding="10">
                    <TextBlock Text="DISPOSITIVOS" FontWeight="Bold" FontSize="10"/>
                </Border>
                <ListBox ItemsSource="{Binding PlcTargets}" SelectedItem="{Binding SelectedTarget}" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Padding="5"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <ContentControl Grid.Column="2" Content="{Binding CurrentView}" Margin="10"/>

        <StatusBar Grid.Row="1" Grid.ColumnSpan="3" Background="#E9ECEF">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="{Binding StatusColor}" Margin="5,0"/>
                    <TextBlock Text="{Binding StatusMessage}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>