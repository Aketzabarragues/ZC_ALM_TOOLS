<UserControl x:Class="ZC_ALM_TOOLS.Views.Generator.ProcessGeneratorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:ZC_ALM_TOOLS.ViewModels.Generator"
             d:DataContext="{d:DesignInstance Type=viewmodels:ProcessGeneratorViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" Padding="15">
            <StackPanel>
                <TextBlock Text="FILTROS" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,5"/>

                <TextBlock Text="Proceso a Generar:" Margin="0,0,0,2" Foreground="#555"/>
                <ComboBox ItemsSource="{Binding Processes}"
                          SelectedItem="{Binding SelectedProcess}"
                          Style="{StaticResource ModernComboBoxStyle}"
                          Height="30" Margin="0,0,0,20">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Nombre}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="Plantilla Base:" Margin="0,0,0,2" Foreground="#555"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" 
                              ItemsSource="{Binding Templates}"
                              SelectedItem="{Binding SelectedTemplate}"
                              Style="{StaticResource ModernComboBoxStyle}"
                              Height="30"/>

                    <Button Grid.Column="1" 
                            Command="{Binding RefreshTemplatesCommand}"
                            Width="30" Height="30" Margin="5,0,0,0"
                            Background="#F0F0F0" BorderBrush="#D0D0D0" BorderThickness="1"
                            Cursor="Hand" ToolTip="Escanear carpeta de plantillas">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                        <Path Fill="#555555" Stretch="Uniform" Width="14" Height="14"
                              Data="M17.65,6.35C16.2,4.9 14.21,4 12,4C7.58,4 4.01,7.58 4.01,12C4.01,16.42 7.58,20 12,20C15.73,20 19.2,17.42 19.82,13.82L17.8,13.82C17.2,16.32 14.86,18 12,18C8.69,18 6,15.31 6,12C6,8.69 8.69,6 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"/>
                    </Button>
                </Grid>

                <Separator Margin="0,0,0,20" Background="#DDD"/>

                <TextBlock Text="WORKFLOW DE CREACIÓN" FontWeight="Bold" Foreground="#005B96" Margin="0,0,0,10"/>

                <TextBlock Text="Paso 1: Comprobaciones" FontWeight="SemiBold" Margin="0,5,0,2" Foreground="#444"/>
                <Button Command="{Binding CompareCommand}" 
                        Content="Comparar con PLC"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="40" Margin="0,0,0,10"/>

                <TextBlock Text="Paso 2: Generación" FontWeight="SemiBold" Margin="0,5,0,2" Foreground="#444"/>
                <Button Command="{Binding GenerateCommand}" 
                        Content="Generar Proceso" 
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="40" Margin="0,0,0,10"/>

                <TextBlock Text="*Importará la plantilla, reescribirá referencias y compilará los bloques." 
                           FontSize="10" Foreground="#888" TextWrapping="Wrap" HorizontalAlignment="Center"/>

                <Button Command="{Binding RunHmiHardcodedPoCCommand}" 
                        Content="Prueba HMI" 
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="40" Margin="0,0,0,10"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Detalles del Proceso a Generar" FontSize="20" FontWeight="Light" Foreground="#333" Margin="0,0,0,20"/>

            <WrapPanel Grid.Row="1" Orientation="Horizontal">
                <Border Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,20,20" Width="200">
                    <StackPanel>
                        <TextBlock Text="ID / NOMBRE" FontSize="11" Foreground="#888" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#005B96">
                            <Run Text="{Binding SelectedProcess.Id}"/>
                            <Run Text=" - "/>
                            <Run Text="{Binding SelectedProcess.Nombre}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,20,20" Width="200">
                    <StackPanel>
                        <TextBlock Text="Nº DE ETAPAS" FontSize="11" Foreground="#888" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding SelectedProcess.NumEtapas}" FontSize="18" FontWeight="SemiBold" Foreground="#333"/>
                    </StackPanel>
                </Border>

                <Border Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,20,20" Width="420">
                    <StackPanel>
                        <TextBlock Text="N_MAX" FontSize="11" Foreground="#888" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="PReal" FontSize="12" Foreground="#666"/>
                                <TextBlock Text="{Binding SelectedProcess.MaxPReal}" FontSize="16" FontWeight="SemiBold" Foreground="#333"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="PInt" FontSize="12" Foreground="#666"/>
                                <TextBlock Text="{Binding SelectedProcess.MaxPInt}" FontSize="16" FontWeight="SemiBold" Foreground="#333"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Alarmas" FontSize="12" Foreground="#666"/>
                                <TextBlock Text="{Binding SelectedProcess.NumAlarmas}" FontSize="16" FontWeight="SemiBold" Foreground="#333"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <TextBlock Grid.Row="2" Text="Análisis de Bloques y Tablas" 
                       FontSize="16" FontWeight="SemiBold" Foreground="#444" Margin="0,10,0,10"/>

            <DataGrid Grid.Row="3" 
                      ItemsSource="{Binding ProjectedBlocks}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="60" ElementStyle="{StaticResource CeldaCentrada}"/>
                    <DataGridTextColumn Header="Archivo plantilla" Binding="{Binding ArchivoOrigen}" Width="250" ElementStyle="{StaticResource CeldaCentrada}"/>
                    <DataGridTextColumn Header="Bloque a generar" Binding="{Binding NombreProyectado}" Width="160" FontWeight="Bold" ElementStyle="{StaticResource CeldaCentrada}"/>
                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100" ElementStyle="{StaticResource Process_EstadoCellStyle}"/>
                    <DataGridTextColumn Header="Mensaje de estado" Binding="{Binding Mensaje}" Width="*" ElementStyle="{StaticResource Process_EstadoCellStyle}"/>
                </DataGrid.Columns>
            </DataGrid>

        </Grid>
    </Grid>
</UserControl>