<UserControl x:Class="ZC_ALM_TOOLS.Views.Vci.VciMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ZC_ALM_TOOLS.Views.Vci"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             Background="#F0F0F0"
             d:DesignHeight="800" d:DesignWidth="1200">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="15,10" Background="#F5F6F7" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCreatingWorkspace}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Workspace de TIA Portal:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#555" Margin="0,0,10,0"/>

                    <ComboBox ItemsSource="{Binding ConfiguredWorkspaces}" 
                              SelectedItem="{Binding SelectedWorkspace}"
                              Style="{StaticResource ModernComboBoxStyle}"
                              DisplayMemberPath="Name"
                              Width="260" Height="35" Margin="0,0,10,0" VerticalContentAlignment="Center"
                              ToolTip="Selecciona un Workspace existente."/>

                    <Button Content="Nuevo" 
                            Command="{Binding ToggleCreateModeCommand}" 
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="85" Margin="0,0,15,0"/>

                    <Button Content="Borrar" 
                            Command="{Binding DeleteWorkspaceCommand}" 
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="85" Margin="0,0,15,0"/>
                    
                    <Button Content="Cambiar ruta" 
                            Command="{Binding ChangeWorkspaceFolderCommand}" 
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="120" 
                            Margin="0,0,15,0"/>
                    
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Ruta en disco:" FontSize="10" Foreground="#888"/>
                        <TextBlock Text="{Binding SelectedWorkspace.Path, TargetNullValue='Ningún workspace seleccionado'}" 
                                   Foreground="#555" FontWeight="Medium" FontStyle="Italic"/>
                    </StackPanel>

                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Visibility="{Binding IsCreatingWorkspace, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Nombre del nuevo Workspace:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" Foreground="#007ACC"/>

                    <TextBox Text="{Binding NewWorkspaceName, UpdateSourceTrigger=PropertyChanged}" 
                             Width="300" Height="35" Margin="0,0,10,0" VerticalContentAlignment="Center" Padding="5,0"
                             ToolTip="Ejemplo: Mi_Workspace_VCI"/>

                    <Button Content="Explorar ruta y Crear" 
                            Command="{Binding CreateNewWorkspaceCommand}" 
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="180"/>

                    <Button Content="Cancelar" 
                            Command="{Binding ToggleCreateModeCommand}" 
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="10,0,0,0" Width="100"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="10" Background="White" BorderBrush="#D0D0D0">
            <TabItem Header="🔄 Mapeo de Archivos">
                <views:VciMappingView DataContext="{Binding MappingVM}" Loaded="VciMappingView_Loaded"/>
            </TabItem>
            <TabItem Header="📋 Auditoría y Sincronización">
                <views:VciAuditView DataContext="{Binding AuditVM}"/>
            </TabItem>
            <TabItem Header="Generador de Ayuda">
                <views:VciDocGeneratorView DataContext="{Binding DocGeneratorVM}"/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>