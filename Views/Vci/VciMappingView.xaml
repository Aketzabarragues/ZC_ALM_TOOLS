<UserControl x:Class="ZC_ALM_TOOLS.Views.Vci.VciMappingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F4F4">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Ruta del Workspace (Disco):" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
            <TextBox Text="{Binding WorkspacePath, UpdateSourceTrigger=PropertyChanged}" Width="500" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <Button Content="Explorar..." Command="{Binding SelectFolderCommand}" Width="80" Padding="5"/>
            <Button Content="🔍 Analizar Proyecto" Command="{Binding AnalyzeProjectCommand}" Margin="20,0,0,0" Width="150" Padding="5" Background="#007ACC" Foreground="White" FontWeight="Bold"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#E8F4F8" BorderBrush="#B9D1EA" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="ℹ️ Estado VCI en TIA Portal: " FontWeight="Bold" Foreground="#333"/>
                <TextBlock Text="{Binding WorkspaceStatusText}" Foreground="#555"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding MappingActions}" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="50">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsSelectable}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Estado" Binding="{Binding StateIcon}" IsReadOnly="True" Width="60"/>
                <DataGridTextColumn Header="Tipo" Binding="{Binding BlockType}" IsReadOnly="True" Width="60"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding BlockName}" IsReadOnly="True" Width="250" FontWeight="Bold"/>
                <DataGridTextColumn Header="Ruta (Disco)" Binding="{Binding DiskPath}" IsReadOnly="True" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="💾 Aplicar Mapeos" Command="{Binding ApplyMappingsCommand}" Padding="15,8" Background="#28A745" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</UserControl>