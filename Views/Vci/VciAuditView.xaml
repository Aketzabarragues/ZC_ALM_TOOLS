<UserControl x:Class="ZC_ALM_TOOLS.Views.Vci.VciAuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F4F4">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Cargar Bloques del PLC" Command="{Binding LoadBlocksCommand}" 
                    Padding="15,5" Margin="0,0,10,0" Background="#3498db" Foreground="White" BorderThickness="0" FontWeight="Bold"/>

            <Button Content="Actualizar Dependencias SCL" Command="{Binding UpdateDependenciesCommand}" 
                    Padding="15,5" Background="#e74c3c" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Blocks}" AutoGenerateColumns="False" 
                  CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" 
                  Background="White" BorderBrush="#DDD" RowBackground="White" AlternatingRowBackground="#F9F9F9">
            <DataGrid.Columns>

                <DataGridTemplateColumn Header="Sel." Width="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                      IsEnabled="{Binding CanUpdateDependencies}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Número" Binding="{Binding Number}" Width="60" IsReadOnly="True"/>
                <DataGridTextColumn Header="Tipo" Binding="{Binding SimpleType}" Width="60" IsReadOnly="True"/>
                <DataGridTextColumn Header="Nombre del Bloque" Binding="{Binding Name}" Width="250" IsReadOnly="True"/>
                <DataGridTextColumn Header="Lenguaje" Binding="{Binding ProgrammingLanguage}" Width="80" IsReadOnly="True"/>

                <DataGridTemplateColumn Header="Estado" Width="150" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ProgrammingLanguage}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="Red"/>
                                        <Setter Property="Text" Value="No Soportado (KOP/FUP)"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanUpdateDependencies}" Value="True">
                                                <Setter Property="Foreground" Value="Green"/>
                                                <Setter Property="Text" Value="Listo para SCL"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsExportable}" Value="True"/>
                                                    <Condition Binding="{Binding CanUpdateDependencies}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Foreground" Value="Orange"/>
                                                <Setter Property="Text" Value="Exportable (No Inyectable)"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>