) -> None:
    """Extrae la presentacion del resumen fuera del flujo principal."""
    console.rule("[bold blue]PREVISIÓN DE GENERACIÓN (PRE-CHECK)[/bold blue]")
    console.print(f"  ▶ Plantilla : [cyan]{origen.nombre}[/cyan]")
