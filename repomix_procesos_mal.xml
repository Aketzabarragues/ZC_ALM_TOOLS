"""
Infrastructure Layer - Proceso XML Modifier
==========================================
Editor QUIRURGICO de bloques de proceso (DB/FC/FB/OB) para inyeccion en TIA Portal.

POR QUE NO USAMOS xml.etree.ElementTree NI minidom:
  - ET inyecta prefijos sinteticos `ns_xxx:` al guardar (ensucia los namespaces).
  - minidom reordena los atributos de los elementos (altera la firma del XML).
  - TIA Portal Openness rechaza ambos formatos con
    "Cannot create the object..." al importar.

SOLUCION (bisturi regex):
  Leemos el archivo como texto plano UTF-8 y usamos re.sub con un callback
  que captura EXCLUSIVAMENTE el inner text de las etiquetas de la whitelist.
  Asi NO tocamos:
    - <ID>          (ID interno de Siemens)
    - <Handle>      (handle del objeto COM)
    - <SystemId>    (UUID interno)
    - <RefId>       (cross-references)
    - <Link>        (enlaces a otros objetos)
    - Atributos (no se desordena nada, no se anade nada)

Whitelist (etiquetas cuyo inner text SI modificamos):
  - <Name>...</Name>           (XML simple)
  - <Number>...</Number>       (XML simple)
  - <Comment>...</Comment>     (XML simple)
  - <Title>...</Title>         (XML simple)
  - <Attribute Name="Name">...</Attribute>
  - <Attribute Name="Number">...</Attribute>
  - <Attribute Name="Comment">...</Attribute>
  - <Attribute Name="Title">...</Attribute>
"""
import logging
import re
from pathlib import Path


class ProcesoXMLModifier:
    """
    Editor quirurgico de XMLs de bloques de proceso (via re.sub puro).

    Uso:
        modifier = ProcesoXMLModifier("ruta/al/bloque.xml")
        if modifier.modificar(reemplazos={"DB51400_PREP_COCINA2": "DB1620_PREP_COC2_1"}, delta=-49780):
            modifier.save()

    CRITICO: el modifier MUTA el archivo. Hacer copia previa si necesitas el original.
    """

    def __init__(self, xml_path: str) -> None:
        self.xml_path = Path(xml_path)
        self._logger = logging.getLogger(f"{__name__}.{self.__class__.__name__}")
        with open(self.xml_path, "r", encoding="utf-8") as f:
            self.xml_content = f.read()

    def modificar(
        self,
        reemplazos: dict[str, str],
        delta: int = 0,
    ) -> bool:
        """
        Aplica los reemplazos literales + la suma del delta EXCLUSIVAMENTE
        al inner text de las etiquetas de la whitelist.

        Args:
            reemplazos: dict[str, str] con los reemplazos literales
                (mismo formato que `calcular_diccionario_reemplazos`).
            delta: desplazamiento numerico a aplicar a cualquier `5\\d{4}`
                encontrado dentro de las etiquetas seguras.

        Returns:
            True si se realizo algun cambio, False en caso contrario.
        """
        original_content = self.xml_content

        # Filtramos los reemplazos validos y ordenamos por longitud descendente
        # (mas largos primero) para evitar colisiones tipo "DB5" antes que
        # "DB51400_PREP_COCINA2".
        reemplazos_validos = sorted(
            ((k, v) for k, v in reemplazos.items() if not k.startswith("__")),
            key=lambda kv: -len(kv[0])
        )

        def mutar_inner_text(match: re.Match) -> str:
            """Callback que muta SOLO el grupo central (inner text)."""
            opening_tag = match.group(1)
            inner_text = match.group(2)
            closing_tag = match.group(3)

            # 1. Reemplazo literal
            for old, new in reemplazos_validos:
                inner_text = inner_text.replace(old, new)

            # 2. Suma del delta a 5\\d{4}
            if delta != 0:
                inner_text = re.sub(
                    r"5\d{4}",
                    lambda m: str(int(m.group(0)) + delta),
                    inner_text,
                )

            return opening_tag + inner_text + closing_tag

        # Etiquetas simples: <Name>...</Name>, <Number>...</Number>, etc.
        # El patron captura: (apertura)(contenido)(cierre). SOLO mutamos (contenido).
        for tag in ["Name", "Number", "Comment", "Title"]:
            patron = rf"(<{tag}[^>]*>)(.*?)(</{tag}>)"
            self.xml_content = re.sub(
                patron, mutar_inner_text, self.xml_content,
                flags=re.DOTALL | re.IGNORECASE,
            )

        # Etiquetas Attribute: <Attribute Name="Name">...</Attribute>
        for tag in ["Name", "Number", "Comment", "Title"]:
            patron = rf'(<Attribute[^>]*Name="{tag}"[^>]*>)(.*?)(</Attribute>)'
            self.xml_content = re.sub(
                patron, mutar_inner_text, self.xml_content,
                flags=re.DOTALL | re.IGNORECASE,
            )

        modificado = self.xml_content != original_content
        if modificado:
            self._logger.debug(
                f"ProcesoXMLModifier (regex): XML mutado, "
                f"reemplazos={len(reemplazos_validos)}, delta={delta}"
            )
        return modificado

    def save(self) -> None:
        """Guarda el contenido modificado en el mismo archivo (UTF-8)."""
        with open(self.xml_path, "w", encoding="utf-8") as f:
            f.write(self.xml_content)
        self._logger.debug(f"XML guardado (Regex Quirurgico): {self.xml_path}")
