                <TextBlock Text="{Binding SelectedCategory.Name, StringFormat='Estado de Sincronización: {0}'}" 
                           FontSize="18" FontWeight="Light" Foreground="#333" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource StatusIndicatorStyle}" Tag="{Binding SelectedCategory.NMaxStatus}">
