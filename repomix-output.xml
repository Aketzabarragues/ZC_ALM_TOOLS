                                <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding StateColor}"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridCell}}" Value="True">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>

                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Tipo" Binding="{Binding BlockType}" IsReadOnly="True" Width="60"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding BlockName}" IsReadOnly="True" Width="250" FontWeight="Bold"/>
                <DataGridTextColumn Header="Ruta (Disco)" Binding="{Binding DiskPath}" IsReadOnly="True" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Eliminar Mapeos" 
                    Command="{Binding UnmapBlocksCommand}" 
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="200" Margin="0,0,15,0"/>
            
            <Button Content="Aplicar Mapeos" 
                    Command="{Binding ApplyMappingsCommand}" 
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="200" Margin="0,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
