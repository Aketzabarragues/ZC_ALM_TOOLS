            <Button Grid.Column="0" 
                    Content="Analizar Workspace" 
                    Command="{Binding AnalyzeProjectCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="160" Margin="0,0,10,0"/>


