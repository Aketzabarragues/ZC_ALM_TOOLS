        <Setter Property="Background" Value="#F2DEDE"/>
        <Setter Property="BorderBrush" Value="#A94442"/>
        <Setter Property="TextBlock.Foreground" Value="#A94442"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>



  <!-- Texto de estado -->
  <Style x:Key="StatusTextStyle" TargetType="TextBlock">
    <Setter Property="Text" Value="PENDIENTE"/>
    <Setter Property="Margin" Value="5,0,0,0"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=Tag}" Value="Ok">
        <Setter Property="Text" Value="CORRECTO ✓"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=Tag}" Value="Error">
        <Setter Property="Text" Value="DIFERENTE ✕"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>



  <!-- Cabecera de datagrid -->
    <Style TargetType="DataGridColumnHeader">
