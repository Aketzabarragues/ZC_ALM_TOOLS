<Window x:Class="ZC_ALM_TOOLS.Views.Launcher.TiaLauncherView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conexión a TIA Portal" Height="280" Width="800"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F5F6F8">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Seleccione la instancia de TIA Portal:" 
                   FontSize="14" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,10"/>

        <ListBox x:Name="lstInstances" Grid.Row="1" Margin="0,0,0,15"
                 BorderBrush="#D1D5DB" BorderThickness="1" Background="White"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding Id, StringFormat='PID: {0}'}" 
                                   FontWeight="Bold" Foreground="#007ACC" Margin="0,0,10,0" Width="120"/>

                        <TextBlock Grid.Column="1" Text="{Binding ProjectPath}" 
                                   Foreground="#555555" TextTrimming="CharacterEllipsis" 
                                   ToolTip="{Binding ProjectPath}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2">
            <Button x:Name="btnRefresh" Content="Refrescar" Width="90" HorizontalAlignment="Left" 
                    Click="BtnRefresh_Click" 
                    Style="{StaticResource SecondaryButtonStyle}"/>

            <Button x:Name="btnConnect" Content="Conectar" Width="110" HorizontalAlignment="Right" 
                    Click="BtnConnect_Click" IsDefault="True" 
                    Style="{StaticResource PrimaryButtonStyle}"/>
        </Grid>
    </Grid>
</Window>
