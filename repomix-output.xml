<file path="Views/Generator/DevicesView.xaml">
<UserControl x:Class="ZC_ALM_TOOLS.Views.Generator.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:ZC_ALM_TOOLS.Core"
             xmlns:viewmodels="clr-namespace:ZC_ALM_TOOLS.ViewModels.Generator" 
             d:DataContext="{d:DesignInstance Type=viewmodels:DevicesViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    
    
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" Padding="15">
            <StackPanel>
                <TextBlock Text="FILTROS" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,5"/>
                <TextBlock Text="Familia de Dispositivos:" Margin="0,0,0,2" Foreground="#555"/>
                <ComboBox ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory}"
                          Style="{StaticResource ModernComboBoxStyle}"
                          Height="30" Margin="0,0,0,20"
                          VerticalContentAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    <ComboBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </ComboBox.Resources>
                </ComboBox>
                <Separator Margin="0,0,0,20" Background="#DDD"/>
                
                <TextBlock Text="WORKFLOW DE SINCRONIZACIÓN" FontWeight="Bold" Foreground="#005B96" Margin="0,0,0,10"/>
                <TextBlock Text="Paso 1: Comprobaciones" FontWeight="SemiBold" Margin="0,5,0,2" Foreground="#444"/>
                
                <Button Command="{Binding CompareCommand}" 
                        Content="Comparar con PLC"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="40" Margin="0,0,0,10"/>
           
                
                <TextBlock Text="Paso 2: Actualización" FontWeight="SemiBold" Margin="0,5,0,2" Foreground="#444"/>
                <Button Command="{Binding SyncCommand}" 
                        Content="Sincronizar dispositivo" 
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="40" Margin="0,0,0,10"/>


                <TextBlock Text="*Sincroniza N_MAX, Constantes y Comentarios DB" FontSize="10" Foreground="#888" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                <TextBlock Text="Paso 3: Opciones HMI (Opcional)" FontWeight="SemiBold" Margin="0,15,0,5" Foreground="#444" Visibility="Hidden"/>
                <Border Background="White" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="12,10" Visibility="Hidden">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Selecciona qué elementos se van a actualizar:" FontSize="11" Foreground="#777" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <CheckBox Content="Variables (Tags)" 
                                  IsChecked="{Binding SyncHmiVariables}" 
                                  Foreground="#333" Margin="0,0,0,8" Cursor="Hand"/>
                        <CheckBox Content="Listas de texto" 
                                  IsChecked="{Binding SyncHmiTextLists}" 
                                  Foreground="#333" Margin="0,0,0,8" Cursor="Hand"/>
                        <CheckBox Content="Alarmas" 
                                  IsChecked="{Binding SyncHmiAlarms}" 
                                  Foreground="#333" Cursor="Hand"/>
                    </StackPanel>
                </Border>
                
            </StackPanel>
        </Border>
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="{Binding SelectedCategory.Name, StringFormat='Estado de Sincronización: {0}'}" 
                           FontSize="18" FontWeight="Light" Foreground="#333" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource StatusIndicatorStyle}" Tag="{Binding SelectedCategory.NMaxStatus}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="N_MAX:"/>
                            <TextBlock Style="{StaticResource StatusTextStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatusIndicatorStyle}" Tag="{Binding SelectedCategory.ConstantsStatus}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Constantes:"/>
                            <TextBlock Style="{StaticResource StatusTextStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatusIndicatorStyle}" Tag="{Binding SelectedCategory.DbStatus}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="DB &amp; Comentarios:"/>
                            <TextBlock Style="{StaticResource StatusTextStyle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Text="Detalle de Dimensionado:" VerticalAlignment="Center" Foreground="#666" Margin="0,0,10,0"/>
                <Border Background="{Binding DimensionColor}" CornerRadius="4" Padding="10,4">
                    <TextBlock Text="{Binding DimensionInfo}" FontSize="12" FontWeight="Bold" Foreground="#333"/>
                </Border>
            </StackPanel>
            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding CurrentDevices}">                
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nº" Binding="{Binding Numero}" Width="50" ElementStyle="{StaticResource CeldaCentrada}"/>
                    <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="180" FontWeight="Bold" ElementStyle="{StaticResource CeldaCentrada}"/>
                    <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*" ElementStyle="{StaticResource CeldaCentrada}"/>
                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="220" ElementStyle="{StaticResource Device_EstadoCellStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
